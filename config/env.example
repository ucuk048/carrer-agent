# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=career_agent
POSTGRES_USER=career_agent
POSTGRES_PASSWORD=replace-me

# LLM provider - Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=4000

# Approval channel
APPROVAL_CHANNEL=telegram
APPROVAL_BASE_URL=https://your-approval-service.example

# Safety limits
MAX_JOBS_PER_BATCH=50
MAX_APPLICATION_DRAFTS_PER_DAY=20
REQUIRE_HUMAN_APPROVAL=true
AUTO_SUBMIT=false
DATA_RETENTION_DAYS=365
